<div class="bh-center bh-mx-1">
  <div class="bh-container">
    <h1>Top 100 players by {{title}}</h1>
    <p><a href="{{basePath}}/leaderboard/categories">Other categories</a></p>
  </div>
  <div class="panel panel-default bh-container bh-mt-1">
    <div class="panel-heading">Leaderboard</div>
    <table class="table table-hover">
      <thead>
        <tr>
          <th>#</th>
          <th>Player</th>
          <th>{{title}}</th>
        </tr>
      </thead>
      <tbody>
        {{#each leaderboard}}
        <tr>
          <td>{{number}}</td>
          <td>
            <a href="{{../basePath}}/player/{{name}}">{{name}}</a>
          </td>
          <td>{{value}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
