<div class="bh-center bh-mx-1">
  <div class="bh-container">
    <h1>Player statistic</h1>
  </div>
</div>

<div class="bh-center bh-mx-1">
  <div class="bh-container">
    <div>
      <div class="bh-w-fit-content">
        <div class="thumbnail bh-min-w-150px">
          <img class="bh-mt-1" src="{{avatarImageUrl}}" alt="player skin">
          <div class="caption">
            <h3>{{ username }}</h3>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="bh-center bh-mx-1">
  <div class="panel panel-default bh-container">
    <div class="panel-heading">Overall statistics</div>
    <table class="table table-hover bh-stats-table">
      <tbody>
        {{#each overallStats}}
        <tr>
          <td><b>{{title}}</b></td>
          <td>{{value}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>

{{#each activityGroups}}
<div class="bh-center bh-mx-1">
  <div class="panel panel-default bh-container">
    <div class="panel-heading">{{title}}</div>
    <table class="table table-hover bh-stats-table">
      <tbody>
        {{#each rows}}
        <tr>
          <td><b>{{title}}</b></td>
          <td>{{value}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
{{/each}}

<div class="bh-center bh-mx-1">
  <div class="panel panel-default bh-container">
    <div class="panel-heading">Block statistic</div>
    <table class="table table-hover">
      <thead>
        <tr>
          <th>Block</th>
          <th>Placed count</th>
          <th>Broken count</th>
        </tr>
      </thead>
      <tbody>
        {{#each blockStats}}
        <tr>
          <td><span class="bh-block-icon {{iconClass}}"></span>{{block}}</td>
          <td>{{placeCount}}</td>
          <td>{{breakCount}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
